# Build output
target/
build/
*.jar

# Node
node_modules/
dist/
.vite/
coverage/
*.tsbuildinfo

# Python (worker)
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.ruff_cache/
*.egg-info/

# IDE
.idea/
*.iml
.vscode/

# OS
.DS_Store

# Local environment — never commit real values
.env
.env.local

# Terraform state contains resource ids and sometimes secrets
.terraform/
*.tfstate
*.tfstate.*
*.tfvars
!example.tfvars

# Certificates generated during local mTLS setup
*.pem
*.key
*.crt
*.p12
!docs/**/*.pem

# Logs
*.log
